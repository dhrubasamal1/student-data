rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * ========================================================================
     * CAMPUS SAATHI (VIT BHOPAL) - STRICT FIRESTORE SECURITY RULES
     * ========================================================================
     * Cryptographic Google Firebase Anonymous Authentication enforced.
     * All sensitive squad data requires request.auth != null AND active registration.
     */

    // Helper: Check if new device registration window is open in config
    function isRegistrationOpen() {
      return get(/databases/$(database)/documents/teacher_reviews/device_access_config).data.registrationOpen == true;
    }

    // Helper: Check if caller possesses a valid Anonymous Auth UID active in registry
    function isAuthorizedStudent() {
      return request.auth != null &&
        get(/databases/$(database)/documents/teacher_reviews/authorized_devices).data.devices[request.auth.uid].status == 'active';
    }

    match /teacher_reviews/{docId} {

      // Public status check: allows client to check if registration is currently open
      match /device_access_config {
        allow read: if true;
        allow write: if isRegistrationOpen() || isAuthorizedStudent();
      }

      // Blocked logs: allows any authenticated device to log blocked attempts; readable by authorized students
      match /device_access_logs {
        allow read: if isAuthorizedStudent();
        allow write: if request.auth != null;
      }

      // Authorized devices registry: readable and writable during open registration or by authorized students
      match /authorized_devices {
        allow read: if isRegistrationOpen() || isAuthorizedStudent();
        allow write: if isRegistrationOpen() || isAuthorizedStudent();
      }

      // PRIVATE SQUAD DATA (Pay Me Later, Activity Tracker, Reviews):
      // Completely BLOCKED to outside intruders. Requires valid authorized Google Auth UID!
      allow read: if isAuthorizedStudent();
      allow write: if isAuthorizedStudent();
    }

    // Deliveries: Accessible only by verified authorized students
    match /deliveries/{deliveryId} {
      allow read, write: if isAuthorizedStudent();
    }
  }
}
